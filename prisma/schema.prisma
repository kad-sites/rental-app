generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          Int       @id @default(autoincrement())
  name        String
  phone       String
  houseNo     String?
  unitNo      String?
  deposit     Float
  rentAmount  Float
  moveInDate  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  aadharUrl   String?
  passportUrl String?
  photoUrl    String?
  agreementUrl String?
  roommate1Name String?
  roommate1Phone String?
  roommate1AadharUrl String?
  roommate1PassportUrl String?
  roommate1PhotoUrl String?
  roommate2Name String?
  roommate2Phone String?
  roommate2AadharUrl String?
  roommate2PassportUrl String?
  roommate2PhotoUrl String?
  isActive            Boolean   @default(true)
  isDeleted           Boolean   @default(false)
  initialMeterReading Float     @default(0)
  lastMeterReading    Float     @default(0)
  ebRate              Float     @default(0)
  invoices            Invoice[]
}

model Invoice {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  amountDue   Float
  dueDate     DateTime
  type        String   @default("RENT") // RENT, EB
  status      String   @default("PENDING") // PENDING, PAID
  whatsappSent Boolean @default(false)
  previousReading Float?
  currentReading  Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
}
